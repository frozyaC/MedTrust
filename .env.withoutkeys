POSTGRES_DSN=postgresql://medtrust:medtrust@localhost:5433/medtrust

CHUNK_SIZE_CHARS=2200
CHUNK_OVERLAP_CHARS=250
EMBEDDING_BATCH_SIZE=32
SEARCH_CANDIDATES=20
DENSE_RRF_WEIGHT=1.0
LEXICAL_RRF_WEIGHT=1.0
PATH_RRF_WEIGHT=1.25

MEMORY_RECENT_MESSAGES=12
MEMORY_SUMMARY_TRIGGER_MESSAGES=12
MEMORY_FOLLOW_UP_MAX_CHARS=300

WEB_SEARCH_ENABLED=true
